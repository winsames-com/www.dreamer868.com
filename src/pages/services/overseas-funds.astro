---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const title = '海外基金債券';
const description = '海外資產配置分散市場、貨幣與地緣政治風險，基金、ETF、債券怎麼選，從這裡開始了解。';

const articles = (await getCollection('articles')).filter(
  (a) => a.data.subcategory === 'overseas-funds'
);
const sorted = [...articles].sort((a, b) => a.data.order - b.data.order);

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: title,
  serviceType: title,
  description,
  provider: { '@id': 'https://www.dreamer868.com/#organization' },
  areaServed: [
    { '@type': 'City', name: '台中市' },
    { '@type': 'Country', name: 'Taiwan' },
  ],
  inLanguage: 'zh-Hant-TW',
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${title}相關文章`,
  itemListElement: sorted.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://www.dreamer868.com/articles/${a.data.slug}`,
    name: a.data.title,
  })),
};
---

<BaseLayout title={title} description={description} jsonLd={[serviceLd, itemListLd]}>
  <PageBanner title={title} />

  <section class="category-content">
    <p class="category-desc">{description}</p>

    <div class="topic-block">
      <h2>為什麼要做海外資產配置</h2>
      <p>
        把資產全部放在同一個市場、同一種貨幣，遇到景氣循環或政策變動時，波動會被放大。海外資產配置常見的做法是搭配外幣存款、海外基金、ETF、債券，依風險屬性拉開比例，不是全押單一工具。
      </p>
      <p>
        股票、債券、基金對市場波動的反應不太一樣，搭配起來能讓整體資產曲線平滑一些，分散配置要處理的就是這件事。
      </p>

      <h2>怎麼開始規劃海外資產配置</h2>
      <p>
        先盤點手上現有資產、抓出自己能承受的波動範圍，再挑管道、分批進場，比一次投入大筆資金穩妥。
      </p>
      <p>每個人的風險屬性和資金水位不同，適合的海外比例落在哪個區間，找顧問依實際狀況估算會比較準。</p>
    </div>

    <div class="articles-grid">
      {sorted.map((article) => (
        <ArticleCard
          title={article.data.title}
          href={`/articles/${article.data.slug}/`}
          image={article.data.images.hero.url}
          imageAlt={article.data.images.hero.alt}
          category={article.data.category}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .category-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px 100px;
  }

  .category-desc {
    font-size: var(--text-base);
    text-align: center;
    color: var(--color-ink-soft);
    margin-bottom: 50px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .topic-block {
    max-width: 800px;
    margin: 0 auto 60px;
  }

  .topic-block h2 {
    font-size: var(--text-lg);
    color: var(--color-text);
    margin-bottom: 16px;
  }

  .topic-block h2:not(:first-child) {
    margin-top: 36px;
  }

  .topic-block p {
    font-size: var(--text-base);
    color: var(--color-ink-soft);
    line-height: 1.8;
    margin-bottom: 16px;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }

  @media (min-width: 640px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
